<ws:partial template="Controls/grid:EmptyTemplate" scope="{{ _options }}" bottomSpacing="{{ null }}" topSpacing="{{ null }}">
   <ws:content>
      <div class="controls-Menu__emptyTemplate">
         <ws:if data="{{contentTemplate}}">
            <ws:partial template="{{contentTemplate}}"/>
         </ws:if>
         <ws:else>
            <div class="controls-Menu__emptyTemplate_defaultText">{[Не найдено]}</div>
         </ws:else>
      </div>
   </ws:content>
</ws:partial>
