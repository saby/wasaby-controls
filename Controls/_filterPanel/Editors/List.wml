<ws:if data="{{_options.isAdaptive && _options.allowAdaptive !== false && (!_options.viewMode || _options.viewMode === 'basic') && _options.filterViewMode === 'default'}}">
    <Controls.Container.Async templateName="Controls/filterPanelAdaptive:AdaptiveList">
        <ws:partial template="{{content.resolvedTemplate}}"
                    scope="{{_options}}"/>
    </Controls.Container.Async>
</ws:if>
<ws:else data="{{_options.editorsViewMode === 'cloud'}}">
    <Controls.Container.Async templateName="Controls/filterPanelEditors:Lookup">
        <ws:partial template="{{content.resolvedTemplate}}"
                    scope="{{_options}}"
                    name="{{_options.name}}"/>
    </Controls.Container.Async>
</ws:else>
<ws:else>
    <Controls._filterPanel.BaseEditor scope="{{_options}}"
                                      closeButtonVisible="{{false}}"
                                      on:extendedCaptionClick="_extendedCaptionClickHandler()"
                                      attr:class="controls-ListEditor__wrapper">
        <ws:editorTemplate>
            <Controls._filterPanel.Editors._List scope="{{_options}}"
                                                 multiSelect="{{_options.editorsViewMode === 'popupCloudPanelDefault' ?
                                          false : _options.multiSelect}}"/>
        </ws:editorTemplate>
    </Controls._filterPanel.BaseEditor>
</ws:else>
