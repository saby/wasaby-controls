<ws:if data="{{_options.storeId === '_browserSyntheticStoreId'}}">
    <ws:partial template="{{_options.content}}"
                on:itemActivate="_itemActivate()"
                itemActions="{{_itemActions}}"
                itemActionVisibilityCallback="{{_itemActionVisibilityCallback}}"
                storeId="{{_options.storeId}}"
    />
</ws:if>
<ws:else>
    <ws:partial template="{{_options.content}}"
                scope="{{_options}}"
                selectedKeys="{{_options.multiSelect ? _selectedKeys: null}}"
                bind:markedKey="_markedKey"
                on:itemActivate="_itemActivate()"
                itemActions="{{_itemActions}}"
                itemActionVisibilityCallback="{{_itemActionVisibilityCallback}}"
    />
</ws:else>
