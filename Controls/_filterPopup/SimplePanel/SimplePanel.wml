<ws:template name="sticky">
   <Controls.popupTemplate:Sticky attr:class="controls_filter_theme-{{_options.theme}}
                                             controls_filterPopup_theme-{{_options.theme}}
                                             controls_dropdownPopup_theme-{{_options.theme}}
                                             controls-Popup__isolatedFocusingContext
                                             controls-SimplePanel_content
                                             controls-SimplePanel_wrapper
                                             {{!_options.isAdaptive ? 'controls-SimplePanel_wrapper-maxWidth'}}
                                             {{!_options.isAdaptive && (_itemsCount > 1 || _options.detailPanelTemplateName) ? 'controls-SimplePanel_background'}}
                                             {{!_options.isAdaptive ? 'controls-SimplePanel-padding-' + ((_itemsCount > 1 || _options.detailPanelTemplateName) ? '2xs' : 's')}}"
                                  headerContentTemplate="{{headerContentTemplate}}"
                                  headerBackgroundStyle="{{(_itemsCount > 1 || _options.detailPanelTemplateName) ? 'unaccented' : 'default'}}"
                                  backgroundStyle="{{(_itemsCount > 1 || _options.detailPanelTemplateName) ? 'unaccented' : 'default'}}"
                                  closeButtonVisible="{{true}}"
                                  closeButtonViewMode="{{(_itemsCount > 1 || _options.detailPanelTemplateName) ? 'linkButton' : _applyButtonVisible ? 'externalWide' : 'external'}}"
                                  borderVisible="{{false}}">
      <ws:bodyContentTemplate>
         <Controls.scroll:Container attr:class="controls-ScrollContainer__flex controls-SimplePanel__scroll
          controls-SimplePanel{{_itemsCount > 1 || _options.detailPanelTemplateName ? '_withHeader' : ''}}-background"
                                    attr:style="{{(_minWidth ? 'min-width: ' + _minWidth + 'px;' : '') + (_minHeight ? 'min-height: ' + _minHeight + 'px;' : '')}}"
                                    topShadowVisibility="hidden"
                                    bottomShadowVisibility="hidden"
                                    scrollbarVisible="{{false}}"
                                    name="contentTemplate">
            <div class="controls-SimplePanel_content {{(_itemsCount > 1 || _options.detailPanelTemplateName) ? 'controls-padding_top-m controls-padding_bottom-m controls-padding_left-xs controls-padding_right-xs'}}">
               <ws:if data="{{_dateMenuItem}}">
                  <Controls.Container.Async templateName="Controls/filterPanelEditors:DateMenu">
                     <ws:partial template="{{ content.resolvedTemplate }}"
                                 on:itemClick="_itemClickDateMenuHandler()"
                                 viewMode="frequent"
                                 scope="{{_dateMenuItem}}"
                     />
                  </Controls.Container.Async>
                  <ws:if data="{{_menuConfigs && _hasMenuConfigs}}">
                     <div className="controls-SimplePanel__multiple_separator"></div>
                  </ws:if>
               </ws:if>
               <ws:if data="{{_menuConfigs}}">
                  <Controls.menu:Multiple menuConfigs="{{_menuConfigs}}"
                                          selectedKeys="{{_selectedKeys}}"
                                          emptyItemFontWeight="{{_itemsCount > 1 ? 'bold' : 'normal'}}"
                                          hoverBackgroundStyle="{{_itemsCount > 1 || _options.detailPanelTemplateName ? 'filterSimplePanel' : 'default'}}"
                                          on:itemClick="_itemClickHandler()"
                                          on:selectedKeysChanged="_selectedKeysChanged()"
                                          on:moreButtonClick="_moreButtonClick()"
                  >
                     <ws:itemTemplate>
                        <ws:if data="{{_needShowEmptyItem(itemTemplate.name, itemTemplate.item.contents.getKey())}}">
                           <ws:partial template="Controls/_filterPopup/SimplePanel/_List/emptyItemTemplate" scope="{{itemTemplate}}" emptyItemFontWeight="{{_itemsCount > 1 ? 'bold' : 'normal'}}"/>
                        </ws:if>
                        <ws:else data="{{_menuConfigs[itemTemplate.name].itemTemplate}}">
                           <ws:partial template="{{_menuConfigs[itemTemplate.name].itemTemplate}}" scope="{{itemTemplate}}" />
                        </ws:else>
                        <ws:else>
                           <Controls.menu:ItemTemplate scope="{{itemTemplate}}" attr:class="{{itemTemplate.item.contents.get('pinned') ? 'controls-SimplePanel-List__row_pinned'}}"/>
                        </ws:else>
                     </ws:itemTemplate>
                  </Controls.menu:Multiple>
               </ws:if>
            </div>
         </Controls.scroll:Container>
         <ws:if data="{{_applyButtonVisible && _itemsCount === 1 && !_options.detailPanelTemplateName}}">
            <div class="controls-SimplePanel__applyButton" data-qa="SimplePanel__applyButton">
               <Controls.buttons:Button viewMode="filled"
                                        icon="icon-Yes"
                                        iconSize="s"
                                        iconStyle="contrast"
                                        attr:class="controls-SimplePanel__applyButton-size"
                                        buttonStyle="success"
                                        on:click="_applySelection()"/>
            </div>
         </ws:if>
      </ws:bodyContentTemplate>
   </Controls.popupTemplate:Sticky>
</ws:template>

<div class="controls-SimplePanel
            {{_itemsCount > 1 || _options.detailPanelTemplateName ? 'controls-SimplePanel_withHeader'}}
            {{!_options.isAdaptive && !(_itemsCount > 1 || _options.detailPanelTemplateName) ? ' controls-SimplePanel_close-padding'}}">
   <ws:if data="{{_itemsCount > 1 || _options.detailPanelTemplateName || _hasSearchInput}}">
      <ws:partial template="sticky">
         <ws:headerContentTemplate>
            <div class="tw-flex tw-w-full {{(_itemsCount > 1 || _options.detailPanelTemplateName) ? 'tw-flex-col' : 'controls-SimplePanel__searchInput-marginRight'}}">
               <ws:if data="{{_itemsCount > 1 || _options.detailPanelTemplateName}}">
                  <div class="controls-SimplePanel-baseline">
                     <div class="controls-SimplePanel__header-wrapper ws-flexbox ws-align-items-baseline
                                 {{!_options.isAdaptive ? 'controls-SimplePanel__header-paddingRight'}}">
                        <Controls.icon:Icon icon="Controls-icons/common:icon-Filter"
                                            iconSize="xs"
                                            iconStyle="primaryFilter"
                                            attr:class="controls-icon controls-margin_left-s controls-margin_right-xs"
                        />
                        <Controls.heading:Title attr:class="ws-ellipsis"
                                                caption="{[Фильтр]}"
                                                fontColorStyle="primaryFilter"
                                                fontSize="xl"
                                                readOnly="{{true}}"
                                                fontWeight="normal"
                                                textTransform="uppercase"
                                                tooltip="{[Фильтр]}"/>
                        <div class="controls-SimplePanel__header
                                  controls-SimplePanel-normal">
                           <ws:if data="{{!_applyButtonVisible}}">
                              <div class="controls-SimplePanel__applyButton-space"></div>
                           </ws:if>
                           <ws:if data="{{!!_options.detailPanelTemplateName}}">
                              <Controls.buttons:Button viewMode="linkButton"
                                                       caption="{[Детальнее]}"
                                                       tooltip="{[Детальнее]}"
                                                       fontColorStyle="label"
                                                       fontSize="xs"
                                                       inlineHeight="m"
                                                       attr:tabindex="-1"
                                                       attr:class="controls-SimplePanel__detail-button"
                                                       attr:data-qa="controls-SimplePanel__detail-button"
                                                       on:click="_openDetailPanel()"/>
                           </ws:if>

                           <ws:if data="{{_applyButtonVisible}}">
                              <div class="" data-qa="SimplePanel__applyButton">
                                 <Controls.buttons:Button viewMode="filled"
                                                          icon="icon-Yes"
                                                          iconSize="s"
                                                          iconStyle="contrast"
                                                          caption="{{null}}"
                                                          attr:class="controls-SimplePanel__applyButton-size"
                                                          buttonStyle="success"
                                                          on:click="_applySelection()"/>
                              </div>
                           </ws:if>
                        </div>
                     </div>
                  </div>
               </ws:if>
               <ws:if data="{{_hasSearchInput}}">
                  <Controls.menu:SearchHeaderTemplate on:search="_search()"
                                                      on:searchReset="_search()"
                                                      scope="{{_searchHeaderConfig}}"
                                                      viewMode="search"
                                                      searchWidth="filterSimplePanelWidth"
                                                      allowAdaptive="{{false}}"
                                                      class="controls-SimplePanel__searchInput
                                                      {{_itemsCount > 1 || _options.detailPanelTemplateName ? 'controls-SimplePanel__searchInHeader-marginLeft controls-margin_bottom-xs' : ''}}"
                  />
               </ws:if>
            </div>
         </ws:headerContentTemplate>
      </ws:partial>
   </ws:if>
   <ws:else>
      <ws:partial template="sticky" />
   </ws:else>
</div>
