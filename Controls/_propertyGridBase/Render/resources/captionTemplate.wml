<ws:if data="{{collectionItem && collectionItem.isNode()}}">
	<div class="controls-PropertyGrid__editor_nodeCaption_wrapper {{!collectionItem.isFirstNode() ? 'controls-margin_top-2xs'}}">
		<Controls.heading:Title scope="{{_options}}"
								readOnly="{{true}}"
								fontSize="m"
								fontColorStyle="{{_options.fontColorStyle ? _options.fontColorStyle : 'secondary'}}"
								fontWeight="{{_options.fontWeight ? _options.fontWeight : 'default'}}"
								tooltip="{{_options.caption}}"
								attr:class="controls-PropertyGrid__editor_nodeCaption"/>
    <ws:if data="{{_options.expanderVisibility !== 'hidden'}}">
      <Controls.icon:Icon
          attr:class="controls-PropertyGrid__editor-expander"
          attr:data-qa="controls-PropertyGrid__editor-expander"
          icon="{{collectionItem.isExpanded() ? 'icon-ExpandLight' : 'icon-MarkCRightLight'}}"
          iconSize="s"
          iconStyle="label"/>
    </ws:if>
	</div>
</ws:if>
<ws:else>
	<Controls.input:Label scope="{{_options}}"
							attr:title="{{_options.caption}}"
							attr:class="controls-fontweight-{{_options.fontWeight ? _options.fontWeight : 'default'}}
                                        {{_options.multiline ? 'controls-PropertyGrid__editor-caption-multiline'}}
                                        {{_options.required ? 'controls-PropertyGrid__editor-caption-required'}}"/>
</ws:else>

