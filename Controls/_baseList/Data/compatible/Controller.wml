<!--Вставляем transparent только для itemsView, в 25.1000 удалено -->
<ws:if data="{{_options.disableSource}}">
  <Controls._baseList.Data.compatible.TransparentContextProvider configs="{{_configs}}" loadResults="{{_loadResults}}">
    <Controls._baseList.Data.compatible.ListContainerConnectedCompatible
        scope="{{_options}}"
        searchValue="{{null}}"
        searchValueForHighlight="{{_options.searchValue}}"
        storeId="_dataSyntheticStoreId"
        name="containerConnected">
      <ws:partial template="{{_options.content}}"/>
    </Controls._baseList.Data.compatible.ListContainerConnectedCompatible>
  </Controls._baseList.Data.compatible.TransparentContextProvider>
</ws:if>
<ws:else>
  <Controls.context:ContextOptionsProvider configs="{{_configs}}" loadResults="{{_loadResults}}">
    <Controls._baseList.Data.compatible.ListContainerConnectedCompatible
        scope="{{_options}}"
        searchValue="{{null}}"
        searchValueForHighlight="{{_options.searchValue}}"
        storeId="_dataSyntheticStoreId"
        name="containerConnected">
      <ws:partial template="{{_options.content}}"/>
    </Controls._baseList.Data.compatible.ListContainerConnectedCompatible>
  </Controls.context:ContextOptionsProvider>
</ws:else>

