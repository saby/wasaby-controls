<Controls-DataEnv.context:Provider configs="{{_configs}}" loadResults="{{_loadResults}}">
	<ws:if data="{{_isOneListInside}}">
		<Controls._baseList.Data.compatible.ListContainerConnectedCompatible
				scope="{{_options}}"
				searchValue="{{_options.isBrowser ? _options.searchValue : null}}"
				searchValueForHighlight="{{_options.searchValue}}"
				name="containerConnected">
			<ws:partial template="{{_options.content}}"/>
		</Controls._baseList.Data.compatible.ListContainerConnectedCompatible>
	</ws:if>
	<ws:else>
		<ws:partial template="{{_options.content}}" scope="{{_options}}"/>
	</ws:else>
</Controls-DataEnv.context:Provider>
