<ws:if data="{{_enabled}}">
    <div class="controls-Graphs-HighChartsLight {{_graphMountedOnMac ? 'Graphs-HighChartsLight-smoothing'}}
                controls_Graphs_theme-{{_options.theme}}"
         name="chartContainer">
    </div>
</ws:if>
<ws:else>
    <span tabindex="{{-1}}">
    </span>
</ws:else>
