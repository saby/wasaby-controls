<div class="controlsDemo__wrapper controlsDemo__flex controlsDemo__flex-flow_wrap">
    <div class="controlsDemo__cell demo-Tumbler__base controls-margin_right-l {{ _widthClass }}">
        <Router.router:Reference
            attr:class="controls-text-label"
            state="app/:app"
            app="{{ 'Controls-demo/toggle/Tumbler/Base/Index' }}"
        >
            <a href="{{ content.href }}">Базовая настройка тумблера</a>
        </Router.router:Reference>
        <Controls-demo.toggle.Tumbler.Base.Index />
    </div>
    <div
        class="controlsDemo__cell demo-Tumbler__selectedKeys controls-margin_right-l {{
            _widthClass
        }}"
    >
        <Router.router:Reference
            attr:class="controls-text-label"
            state="app/:app"
            app="{{ 'Controls-demo/toggle/Tumbler/SelectedKeys/Index' }}"
        >
            <a href="{{ content.href }}">Настройка выбранных элементов</a>
        </Router.router:Reference>
        <Controls-demo.toggle.Tumbler.SelectedKeys.Index />
    </div>
    <div
        class="controlsDemo__cell demo-Tumbler__horizontal controls-margin_right-l {{
