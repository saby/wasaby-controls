<Controls.scroll:Container
    scrollbarVisible="{{ false }}"
    shadowMode="js"
    attr:class="VerticalTabs-buttons"
>
    <div
        class="VerticalTabs-buttons__wrapper controls_popupTemplate_theme-{{
            _options.theme
        }} controls_VerticalTabs_theme-{{ _options.theme }}"
        name="itemsContainer"
    >
        <ws:for data="index, item in _options.items">
            <div
                class="VerticalTabs-buttons__button {{ _getBackgroundStyle(item) }}
                        {{ index !== 0 ? 'VerticalTabs-buttons__button-spacing' }}
                        {{ index === _options.items.getCount() + 1 ? 'controls-margin_bottom-xs'}}
                        {{ _options.offset ? 'VerticalTabs-buttons__button-offset_' + _options.offset }}
                        {{ item.get('buttonIcon') ? 'VerticalTabs-buttons__button_withButton' }}
                        "
                style="{{ _getItemStyle(item) }}"
                on:click="_itemClickHandler(item, index)"
                data-qa="FloatingTabs-buttons__button"
            >
                <div
                    class="VerticalTabs-buttons__button-title"
                    data-qa="FloatingTabs-buttons__button-title"
                >
                    <Controls.heading:Title
                        attr:class="VerticalTabs-buttons__heading-title ws-ellipsis"
                        readOnly="{{ true }}"
                        fontSize="{{ item.get('fontSize') || _options.fontSize || 'l' }}"
                        fontColorStyle="{{ item.get('fontColorStyle') || _options.fontColorStyle }}"
                        fontWeight="{{ _getFontWeight(item) }}"
                        textTransform="{{ item.get('textTransform') || _options.textTransform }}"
                        caption="{{ _getItemCaption(item) }}"
                    />
                    <Controls.heading:Title
                        attr:class="VerticalTabs-buttons__heading-title VerticalTabs-buttons__heading-title__fake ws-ellipsis"
                        readOnly="{{ true }}"
                        fontSize="{{ item.get('fontSize') || _options.fontSize || 's' }}"
                        fontWeight="bold"
                        textTransform="{{ item.get('textTransform') || _options.textTransform }}"
                        caption="{{ _getItemCaption(item) }}"
                    />
                </div>
                <ws:if data="{{ item.get('icon') }}">
                    <Controls.icon:Icon
                        icon="{{ item.get('icon') }}"
                        iconSize="m"
                        iconStyle="{{ item.get('iconStyle') || 'default' }}"
                        attr:class="VerticalTabs-buttons__button-icon"
                    />
                </ws:if>
                <ws:if data="{{ item.get('mainCounter') }}">
                    <div data-qa="FloatingTabs-buttons__button-counter" class="VerticalTabs-buttons__button-counter">
                        <Controls.heading:Counter
                            fontSize="{{
                                item.get('mainCounterFontSize') ||
                                    _options.mainCounterFontSize ||
                                    'm'
                            }}"
                            readOnly="{{ true }}"
                            fontColorStyle="{{
                                item.get('mainCounterFontColorStyle') ||
                                    _options.mainCounterFontColorStyle ||
                                    'label'
                            }}"
                            caption="{{ item.get('mainCounter') }}"
                        />
                    </div>
                </ws:if>
                <ws:if data="{{ item.get('buttonIcon') }}">
                    <Controls.buttons:Button
                        data-qa="FloatingTabs-buttons__button-button"
                        icon="{{ item.get('buttonIcon') }}"
                        attr:class="VerticalTabs-buttons__button-button"
                        viewMode="filled"
                        iconStyle="default"
                        buttonStyle="default"
                        iconSize="m"
                        buttonSize="l"
                        on:click="_onButtonClick(item)"
                    />
                </ws:if>
            </div>
        </ws:for>
    </div>
</Controls.scroll:Container>
