exports[`Source_Hierarchy. Тесты взаимодействия загрузки данных и иерархии. Раскрытие узлов За одно обновление можно раскрыть сразу несколько узлов 2`] = `
Array [
  Array [
    Изменений не произошло,
  ],
  Array [
    Изменений не произошло,
  ],
  Array [
    	- expandedItems: {"from":[]} -> {"to":["1","2","3"]},
    	- loading: false -> false,
    		loading: false,
    			loading: true,
    				loading: false,
    	- hasMoreStorage: {"from":{}} -> {"to":{"1":{"forward":false,"backward":false},"2":{"forward":false,"backward":false},"3":{"forward":false,"backward":false}}},
    	- expansionModel: {"from":{}} -> {"to":{}},
  ],
  Array [
    	- selectionModel: {"from":{}} -> {"to":{}},
    		selectionModel: {},
    			selectionModel: {},
    				selectionModel: {},
    					selectionModel: {},
  ],
]
`;

