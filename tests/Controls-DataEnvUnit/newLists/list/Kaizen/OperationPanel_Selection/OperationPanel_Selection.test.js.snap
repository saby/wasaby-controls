exports[`OperationPanel_Selection. Тесты взаимодействия ПМО со множественным выделением. Выбрать все Можно сбросить все выделение, если инвертировать, когда выделены все элементы 4`] = `
Array [
  Array [
    	- collection: undefined -> 'Controls/display:Collection',
    	- command: null -> 'selectAll',
  ],
  Array [
    	- selectedKeys: {"from":[]} -> {"to":[null]},
    	- listCommandsSelection: {"from":"undefined"} -> {"to":{"selected":[null],"excluded":[]}},
    		listCommandsSelection: undefined,
    			listCommandsSelection: {"selected":[null],"excluded":[]},
    				listCommandsSelection: {"selected":[null],"excluded":[]},
    	- selectionModel: {"from":{}} -> {"to":{}},
  ],
  Array [
    	- count: 0 -> 5,
    	- isAllSelected: false -> true,
    	- listId: undefined -> 'uniqueId0',
    	- command: 'selectAll' -> null,
  ],
  Array [
    	- command: null -> 'toggleAll',
  ],
  Array [
    	- selectedKeys: {"from":[null]} -> {"to":[]},
    	- listCommandsSelection: {"from":{"selected":[null],"excluded":[]}} -> {"to":{"selected":[],"excluded":[]}},
    		listCommandsSelection: {"selected":[null],"excluded":[]},
    			listCommandsSelection: {"selected":[],"excluded":[]},
    				listCommandsSelection: {"selected":[],"excluded":[]},
    	- selectionModel: {"from":{}} -> {"to":{}},
  ],
  Array [
    	- count: 5 -> 0,
    	- isAllSelected: true -> false,
    	- command: 'toggleAll' -> null,
  ],
]
`;

