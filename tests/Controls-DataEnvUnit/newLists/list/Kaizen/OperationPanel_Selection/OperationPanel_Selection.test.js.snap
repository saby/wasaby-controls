exports[`OperationPanel_Selection. Тесты взаимодействия ПМО со множественным выделением. Поддержка прикладных возможностей При открытии ПМО listCommandsSelection должен содержать элемент, на котором стоит маркер  2`] = `
Array [
  Array [
    	- collection: undefined -> 'Controls/display:Collection',
    	- operationsPanelVisible: false -> true,
    	- multiSelectVisibility: 'hidden' -> 'visible',
    	- markerVisibility: 'onactivated' -> 'visible',
    	- markedKey: undefined -> 1,
    	- listCommandsSelection: {"from":"undefined"} -> {"to":{"selected":[1],"excluded":[]}},
  ],
  Array [
    Изменений не произошло,
  ],
]
`;

