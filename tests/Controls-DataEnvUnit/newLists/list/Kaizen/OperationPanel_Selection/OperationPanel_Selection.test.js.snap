exports[`OperationPanel_Selection. Тесты взаимодействия ПМО со множественным выделением. Поддержка прикладных возможностей listCommandsSelection Элемент с checkboxAccessibility false не должен попадать в выбранные 2`] = `
Array [
  Array [
    	- collection: undefined -> 'Controls/display:Collection',
    	- operationsPanelVisible: false -> true,
    	- multiSelectVisibility: 'hidden' -> 'visible',
    	- markerVisibility: 'onactivated' -> 'visible',
  ],
  Array [
    Изменений не произошло,
  ],
]
`;

